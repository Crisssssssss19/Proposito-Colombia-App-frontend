{
  "expo": {
    "name": "swallow-app",
    "slug": "swallow-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/GolondrinaSinLetras.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/GolondrinaSinLetras.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.cris_an.swallowapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "08f55f23-cd6a-4680-aef2-06a0b3e01484"
      }
    }
  }
}
